# Supabase Postgres (pooler para a app, non-pooling só pro drizzle-kit push)
POSTGRES_URL="postgres://postgres.xxxx:senha@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
POSTGRES_URL_NON_POOLING="postgres://postgres.xxxx:senha@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Anthropic (extração da mensagem do WhatsApp)
ANTHROPIC_API_KEY="sk-ant-..."

# Z-API (instância do WhatsApp)
ZAPI_INSTANCE_ID=""
ZAPI_INSTANCE_TOKEN=""
ZAPI_CLIENT_TOKEN=""

# URL pública da app (usada para montar o link /d/[id] mandado no WhatsApp)
NEXT_PUBLIC_APP_URL="https://seu-projeto.vercel.app"
